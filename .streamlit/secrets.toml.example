# Streamlit Community Cloud Secrets Configuration Example
# In Streamlit Cloud: App Settings > Secrets
# Locally: Copy to .streamlit/secrets.toml (do not commit secrets.toml)

# Groq API Key (required for cloud inference)
GROQ_API_KEY = "gsk_your_groq_api_key_here"

# Optional: Default LM Studio Tunnel URL if connecting to local LLM from cloud
# LM_STUDIO_BASE_URL = "https://your-tunnel-subdomain.ngrok-free.app"
